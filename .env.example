# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# GOOGLE_WEB_CLIENT_ID: Your Google OAuth 2.0 Web Client ID from Google Cloud Console.
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# BACKEND_URL: The base URL for your backend API.
# Local emulator: http://10.0.2.2:5000/
# Railway (replace with your actual URL): https://your-app.up.railway.app/
BACKEND_URL=http://10.0.2.2:5000/

# EmailJS Configuration: Required for sending OTP emails.
# Get these from your EmailJS dashboard: https://dashboard.emailjs.com/
EMAILJS_SERVICE_ID=YOUR_EMAILJS_SERVICE_ID
EMAILJS_TEMPLATE_ID=YOUR_EMAILJS_TEMPLATE_ID
EMAILJS_PUBLIC_KEY=YOUR_EMAILJS_PUBLIC_KEY
